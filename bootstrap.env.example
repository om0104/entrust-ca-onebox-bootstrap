# bootstrap.env — non-secret parameters for the ECA 10.2 + CAGW 3.8 one-box bootstrap.
# Copy to  bootstrap.env  and edit. Secrets are NOT here — they are generated into ./secrets/.

# ---- identity / directory -------------------------------------------------
ECA_FQDN=ca01.pki.example.net        # this VM's lowercase FQDN (must resolve, fwd + reverse)
DS_SUFFIX=dc=example,dc=net    # LDAP base suffix
DS_INSTANCE=eca                       # 389-ds instance name  (-> dirsrv@eca)
CA_OU_DN=ou=CA,dc=example,dc=net

# ---- ECA engine ---------------------------------------------------------
CA_RSA_BITS=4096                      # root CA signing key size
PKIX_PORT=829                         # PKIX-CMP listener
ASH_PORT=710                          # ASH listener
XAP_PORT=443                          # XAP (admin) listener

# ---- HSM (nShield) ----------------------------------------------------
# The CA signing key is protected by an nShield softcard. Two ways to attach the HSM:
#
#   HSM_MODE=nethsm   the VM enrols to a remote hardserver that exports a module
#                     (an nShield Connect/5c, or a 5s in another host acting as NetHSM).
#                     Requires the client to be authorised on the HSM side first
#                     (managed HSM: your HSM admin; lab 5s-in-Proxmox: helpers/hsm_authorize_client.sh).
#   HSM_MODE=rfs      the Security World is delivered by an RFS you can rfs-sync from,
#                     and a local/attached module is already visible to `enquiry`.
#
HSM_MODE=nethsm
SOFTCARD_NAME=onebox-ca                 # created by stage 20 if it does not exist

# HSM_MODE=nethsm parameters:
HSM_NETHSM_ADDR=10.0.0.10                       # hardserver address
HSM_NETHSM_ESN=XXXX-XXXX-XXXX                   # module ESN  (nfkminfo on the HSM host)
HSM_NETHSM_KNETI=0000000000000000000000000000000000000000   # hardserver KNETI (anonkneti 127.0.0.1 on the HSM host)

# HSM_MODE=rfs parameters:
HSM_RFS_ADDR=

# SecWorld installer: a directory or ISO holding linux/amd64/{hwsp,ctls,raserv}.tar.gz
NSHIELD_SW_SRC=/mnt/secworld.iso

# ---- media --------------------------------------------------------------
# Directory holding the Entrust ECA 10.2 media (see README.md for the file list).
MEDIA_DIR=./media

# ---- CA Gateway 3.8 ---------------------------------------------------
CAGW_PORT=8444                        # host port for the mTLS REST API
CAGW_CA_ID=eca                        # authority id in application.yml + the URL path segment
CAGW_IMAGE=docker.io/cagw/api:3.8.0
CAGW_RUN_USER=pkiadmin                # unprivileged user that runs the rootless container
CONFIG_DIR=/opt/eca-cagw/config       # bind-mounted into the container at /etc/cagw/config
# Location of the CAGW image + tooling:
CAGW_IMAGE_TAR=./media/cagw-api-3.8.0-3777.docker.tar.gz    # podman load source (or "" to pull)
CAGW_LICENSE_FILE=./media/cagw-license.lic                  # signed CAGW licence bundle
CAGW_PCU_ZIP=./media/cagw-profilecreationutility-linux64-11.0.1.19.zip

# ---- manual ECAA Step D (stage 70) ----------------------------------
# Fill these AFTER doing the ECAA procedure (stages/70_PAUSE_ecaa_stepd.md) to run
# the back half unattended; leave blank to have the bootstrap pause and prompt.
CAGW_ADMIN_REF=
CAGW_ADMIN_AUTHCODE=
CAGW_ADMIN_USER_DN=cn=cagw xapv2,ou=CA,dc=example,dc=net

# ---- device-identity enrolment profiles (application.yml) -----------
# DEVICE_CERT_DEFINITION must exist inside DEVICE_CERT_TYPE. Keep ent_skp_dualusage
# ("1-Key-Pair User", has Dual Usage). ECA's ent_default has only Encryption +
# Verification, so Dual Usage enrolments fail with "certificate definition ... not present".
DEVICE_CERT_TYPE=ent_skp_dualusage     # ECA cert type backing both profiles
DEVICE_CERT_DEFINITION=Dual Usage
